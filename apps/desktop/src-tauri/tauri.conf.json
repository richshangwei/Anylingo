{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "隨譯",
  "version": "0.2.5",
  "identifier": "app.floatrans.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "隨譯 Anylingo",
        "width": 480,
        "height": 640,
        "minWidth": 36,
        "minHeight": 36,
        "center": true,
        "decorations": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "action",
        "title": "翻譯選取文字",
        "url": "index.html",
        "width": 34,
        "height": 34,
        "visible": false,
        "focus": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "transparent": true,
        "resizable": false
      },
      {
        "label": "region",
        "title": "截圖翻譯",
        "url": "index.html",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "transparent": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"]
  }
}
